# Copy to .env and fill in. .env is gitignored — the key must never be committed.
OPENROUTER_API_KEY=your_openrouter_key

# Must be a model that accepts images, or the screenshots are wasted — and
# it has to be good at reading small UI text, which the cheap vision models
# are not: they return plausible numbers rather than the ones on screen.
# e.g. openai/gpt-4o, anthropic/claude-3.5-sonnet, google/gemini-2.0-flash-001
OPENROUTER_MODEL=openai/gpt-4o
