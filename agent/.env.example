# Copy to .env and fill in. .env is gitignored — the key must never be committed.
OPENROUTER_API_KEY=your_openrouter_key

# Must be a model that accepts images, or the screenshots are wasted.
# e.g. openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, google/gemini-2.0-flash-001
OPENROUTER_MODEL=openai/gpt-4o-mini
